# seance-kit config. Copy to ~/.config/seance-kit/config.env and edit.
#   mkdir -p ~/.config/seance-kit && cp config/config.env.sample ~/.config/seance-kit/config.env
# Plain KEY=value lines, read by Invoke (Python) and the shell scripts. No spaces around "=".
# Any key can also come from the environment as SEANCE_KIT_<KEY> (the environment wins).
# Quote values with spaces. ~ and $HOME are expanded.
# Run `invoke/seance-chat check` to see what is still missing.

# ---- Invoke: who may use it (REQUIRED, unless LOCAL_MODE=1) ----------------------------------
# The Tailscale login (the email you sign in to Tailscale with). `tailscale serve` adds it to every
# request as the Tailscale-User-Login header and Invoke lets in only this login.
# Any other proxy works too, if it sets that header and strips it from outside requests.
OWNER=you@example.com

# The https address you open on your phone. With Tailscale: https://<machine>.<your-tailnet>.ts.net:8443
# (`tailscale status` shows the machine and tailnet name; the port is the one you give to `tailscale serve`).
ORIGIN=https://your-machine.your-tailnet.ts.net:8443

# Use Invoke from a browser on the same machine only: no Tailscale, no login. Open http://127.0.0.1:9667
# Do not combine with tailscale serve or any proxy that lets other people reach the port.
#LOCAL_MODE=1

# ---- Invoke: optional ---------------------------------------------------------------------------
#HOST=127.0.0.1
#PORT=9667
# Contact for web push, a mailto: or https URL. Default: ORIGIN without its port.
#VAPID_SUBJECT=mailto:you@example.com
# Paths, if the commands are not on PATH when Invoke runs under systemd or launchd.
#SEANCE_BIN=/home/you/.local/bin/seance
#GH_BIN=/usr/bin/gh
#CLAUDE_BIN=/home/you/.local/bin/claude
# Claude plan usage strip: a JSON file you or a script write, {"five_hour": {"used": 12, "resets_at": 1760000000},
# "seven_day": {...}} (used is a percent, resets_at is Unix seconds). No file, no strip.
#USAGE_FILE=~/.local/share/seance-kit/claude-usage.json

# ---- PR chip and spec cards ---------------------------------------------------------------------
# Whose open pull requests the PR chip lists. Needs the `gh` command, logged in (gh auth login).
# "@me" means the logged-in user. Or a GitHub login.
#PR_AUTHOR=@me
# Which circle owns which project folder: a tab-separated file, one line per circle:
#   <circle slug><TAB><folder>      (folder is relative to this file; lines starting with # are ignored)
# A PR whose link appears in a .md file in a circle's folder is filed under that circle. Without this
# file every PR shows in the Alerts thread. Go on a spec card also saves the spec to SPECS.md in the folder.
#CIRCLES_MAP=~/projects/circles.tsv
# A circle (slug) that mentions most PRs, like a planning circle. It only keeps PRs no other circle claims.
#PR_SHARED_CIRCLE=planning

# ---- A Mac as a second machine (all optional) ----------------------------------------------------
# For a server that is not the Mac: phone photos are copied to Mac panes, `image:` files are fetched from
# them, and the phone stays quiet while you are typing at the Mac. Leave MAC_SSH empty to skip all of it.
# Use MAC_SSH=local when Invoke itself runs on the Mac. The ssh login must work without a password prompt.
#MAC_SSH=you@your-mac.local
#MAC_SSH_KEY=~/.ssh/id_ed25519
# Absolute folder on the Mac for copied photos (required with MAC_SSH).
#MAC_FILES=/Users/you/.cache/invoke
# Seance pane names that contain this text count as Mac panes (default: "· Mac").
#MAC_PANE_TAG="· Mac"

# ---- afk ---------------------------------------------------------------------------------------
# How afk reaches the other machine. See afk/README.md.
#SERVER_SSH=your-server       # from the Mac: how to reach the machine that runs Invoke, or "local"
# MAC_SSH (above) is used from the server to reach the Mac, or "local" if you run afk on the Mac.
#INVOKE_BIN=/home/you/seance-kit/invoke/seance-chat   # seance-chat on the server (default: this kit)
#AFK_BIN=/path/to/afk         # for Invoke's AFK button, if afk is not next to the kit

# ---- theme sync ---------------------------------------------------------------------------------
#CLAUDE_DIR=~/.claude
#SAVED_THEME=~/.local/share/seance/theme.json
#MAC_CLAUDE_THEME=/Users/you/seance-kit/theme-sync/claude-theme   # with MAC_SSH, also sync the Mac
