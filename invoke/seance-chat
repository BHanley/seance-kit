def ctl(*args, timeout=60):
    """`seance ctl ...`. With no seance binary the answer is empty (no circles) instead of a crash."""
    try:
        return subprocess.run([SEANCE, "ctl", *args], capture_output=True,
                              text=True, timeout=timeout)
    except FileNotFoundError:
        if not _seance_told:
            _seance_told.append(1)
            print(f"seance-chat: can't find the `seance` command ({SEANCE}). Install Seance "
                  "(https://github.com/zackham/seance) or set SEANCE_BIN in config.env. "
                  "Until then there are no circles to show.", file=sys.stderr, flush=True)
        return subprocess.CompletedProcess(args, 127, "", f"{SEANCE}: command not found")


def panes():
    out = ctl("list", "--all", "--json")
    try:
        return json.loads(out.stdout)["data"]["panes"]
    except (ValueError, KeyError):
        return []


def circles(ps=None):
    seen = {}
    for p in panes() if ps is None else ps:
        seen.setdefault(p["workspace"], p.get("workspace_name") or p["workspace"])
    return seen


def spaces():
    """Seance's spaces in rail order: [(id, name, [circle slugs])]."""
    out = ctl("space", "list", "--json")
    try:
        rows = json.loads(out.stdout)["data"]["spaces"]
    except (ValueError, KeyError, TypeError):
        return []
    return [(s["id"], s["name"], [c["workspace"] for c in s["circles"]]) for s in rows]


def arranged(names):
    """Seance's spaces and circles in Seance's own order; circles in no space
    land in Other, last."""
    sp = spaces()
    placed = {ws for _, _, cs in sp for ws in cs}
    rest = [ws for ws in names if ws not in placed and ws != ALERTS]
    if rest:
        sp.append(("_other", "Other", rest))  # underscore: never a Seance space id
    # Empty spaces stay, so a circle can be dragged into (or back to) them.
    return [{"id": sid, "name": name, "circles": [c for c in cs if c in names]}
            for sid, name, cs in sp]


def sprite_seeds():
    """`seance-lead-sprite.<slug> = SEED` overrides from terminal.conf, so a
    circle's creature here matches the one on its lead pane."""
    seeds = {}
    try:
        with open(os.path.expanduser("~/.config/seance/terminal.conf")) as f:
            for line in f:
                key, _, val = line.partition("=")
                key = key.strip()
                if key.startswith("seance-lead-sprite.") and val.strip():
                    seeds[key.removeprefix("seance-lead-sprite.")] = val.strip()
    except OSError:
        pass
    return seeds


def lead_of(ws):
    """The circle's live lead pane, or None. Never starts one: new Claude
    sessions belong to whatever launched the lead (a lead-watch script, say)."""
    out = ctl("lead", ws, "--json")
    try:
        lead = json.loads(out.stdout)["data"]["lead"]
    except (ValueError, KeyError, TypeError):
        return None
    live = {p["slug"]: p for p in panes() if not p.get("exited")}
    return lead if lead in live and live[lead].get("kind") == "terminal" else None


def pad_text(pane):
