def alert_token():
    path = os.path.join(CONF, "alert-token")
    tok = read_json(path, None)
    if not tok:
        tok = secrets.token_hex(16)
        write_atomic(path, json.dumps(tok))
        os.chmod(path, 0o600)
    return tok


