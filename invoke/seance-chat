class Store:
    """Messages in memory, appended to messages.jsonl (a line with only id and
    status patches an earlier message). `version` ticks on every change so
    long-polling clients wake."""

    def __init__(self):
        self.lock = threading.Condition()
        self.msgs = {}
        self.version = 0
        self.names = {}
        if os.path.exists(LOG):
            with open(LOG) as f:
                for line in f:
                    try:
                        m = json.loads(line)
                    except ValueError:
                        continue
                    if m["id"] in self.msgs:
                        self.msgs[m["id"]].update(m)
                    else:
                        self.msgs[m["id"]] = m
        self.next_id = max(self.msgs, default=0) + 1
        self.read = read_json(os.path.join(STATE, "read.json"), {})
        self.subs = read_json(os.path.join(STATE, "subs.json"), [])
        self.pending = read_json(os.path.join(STATE, "pending.json"), {})
        # A restart between the send and its pending record strands "sending".
        for mid, m in self.msgs.items():
            if m.get("status") == "sending" and str(mid) not in self.pending:
                m["status"] = "failed"
                self._append({"id": mid, "status": "failed"})

    def _append(self, rec):
        os.makedirs(STATE, exist_ok=True)
        with open(LOG, "a") as f:
            f.write(json.dumps(rec) + "\n")

    def _bump(self):
        self.version += 1
        self.lock.notify_all()

    def add(self, ws, who, text, status=None, image=None, images=(), device=None, choices=(),
            attachment=None, spec=None):
        with self.lock:
            m = {"id": self.next_id, "ws": ws, "from": who, "text": text,
                 "ts": int(time.time() * 1000)}
            if status:
                m["status"] = status
            if device:
                m["device"] = device
            if choices:
                m["choices"] = list(choices)
            if spec:
                m["spec"] = spec
            if attachment:
                m["attachment"] = attachment
            # "images" lists every picture; "image" stays the first for older readers.
            images = [image] if image else list(images)
            if images:
                m["image"] = images[0]
            if len(images) > 1:
                m["images"] = images
            self.next_id += 1
            self.msgs[m["id"]] = m
            self._append(m)
            self._bump()
            return dict(m)

    def unpick(self, mid):
        """A tapped button that did nothing: it can be tapped again."""
        with self.lock:
            self.msgs[mid]["picked"] = None
            self._append({"id": mid, "picked": None})
            self._bump()

    def pick(self, mid, choice):
        """The user tapped one of a lead's offered answers: remember which, so it shows as chosen."""
        with self.lock:
            m = self.msgs.get(mid)
            if not m or not m.get("choices") or m.get("picked"):
                return False
            m["picked"] = choice
            self._append({"id": mid, "picked": choice})
            self._bump()
            return True

    def set_status(self, mid, status, **extra):
        extra.setdefault("mode", "")  # Send now only applies to a waiting note
        with self.lock:
            self.msgs[mid].update(status=status, **extra)
            self._append({"id": mid, "status": status, **extra})
            self._bump()

    def thread(self, ws, after=0):
        with self.lock:
            return [dict(m) for m in self.msgs.values() if m["ws"] == ws and m["id"] > after]

    def unread(self, ws):
        last = self.read.get(ws, 0)
        return sum(1 for m in self.msgs.values()
                   if m["ws"] == ws and m["from"] != "me" and m["id"] > last)

    def total_unread(self):
        """Across the circles the list shows (gone circles can't be cleared)."""
        live = set(self.names or circles()) | {ALERTS}
        with self.lock:
            return sum(self.unread(ws) for ws in {m["ws"] for m in self.msgs.values()} & live)

    def mark_read(self, ws, mid):
        with self.lock:
            if mid > self.read.get(ws, 0):
                self.read[ws] = mid
                write_atomic(os.path.join(STATE, "read.json"), json.dumps(self.read))
                self._bump()

    def mark_unread(self, ws):
        """The user wants this thread to look new again: its newest message counts as unread."""
        with self.lock:
            ids = [m["id"] for m in self.msgs.values() if m["ws"] == ws and m["from"] != "me"]
            if not ids:
                return False
            self.read[ws] = min(self.read.get(ws, 0), max(ids) - 1)
            write_atomic(os.path.join(STATE, "read.json"), json.dumps(self.read))
            self._bump()
            return True

    def summary(self):
        ps = panes()
        names = dict(circles(ps))
        self.names = names
        # A circle with any pane mid-turn (lead or helper) shows as working.
        working = {p["workspace"] for p in ps if p.get("activity") == "busy"}
        with self.lock:
            last = {}
            for m in self.msgs.values():
                last[m["ws"]] = m
            names.setdefault(ALERTS, "Alerts")
            rows = []
            seeds = sprite_seeds()
            for ws, name in names.items():
                lm = last.get(ws)
                if ws == ALERTS and not lm:
                    continue
                rows.append({"ws": ws, "name": "Alerts" if ws == ALERTS else name,
                             "seed": seeds.get(ws, ws),
                             "unread": self.unread(ws), "working": ws in working or bool(subagent_runs.get(ws)),
                             "crew": crew(ws, ps),
                             "last": {k: lm.get(k) for k in ("from", "text", "ts", "image")} if lm else None})
            version = self.version
        return rows, arranged(names), version

    def save_subs(self):
        write_atomic(os.path.join(STATE, "subs.json"), json.dumps(self.subs))

    def save_pending(self):
        write_atomic(os.path.join(STATE, "pending.json"), json.dumps(self.pending))

    def wait(self, since):
        """Block until something changes. A client ahead of us (the server
        restarted and version began again) gets an answer at once."""
        with self.lock:
            self.lock.wait_for(lambda: self.version != since, timeout=POLL_SECS)
            return self.version


