AT_PANE = re.compile(r"@(\S+)\s+\S")
PEEK_LINES = 60


def circle_panes(ws):
    """The circle's live terminals, the lead first."""
    lead = lead_of_cached(ws)
    rows = [p for p in panes() if p["workspace"] == ws and p.get("kind") == "terminal"
            and not p.get("exited")]
    return sorted(rows, key=lambda p: p["slug"] != lead)


def pane_label(p):
    """The pane's name without its Mac machine tag."""
    return re.split(r"\s*·\s*", p.get("name") or p["slug"])[0] or p["slug"]


def short_name(p):
    """The word the user types after @: "my-circle Builder" is Builder."""
    name = pane_label(p).split(" (")[0].split()
    return name[-1] if name else p["slug"]


def takes_tasks(p):
    """A pane with an agent in it. A task sent to a plain shell would be pasted in and run."""
    return (re.search(r"claude|codex", p.get("command") or "") is not None
            and (p.get("activity") != "unknown" or bool(p.get("asleep"))))  # unknown: Claude has quit


def find_helper(ws, word):
    """The helper pane @word means, or None: not the lead, and never a guess between two."""
    word, lead = word.lower(), lead_of_cached(ws)
    hits = [p for p in circle_panes(ws) if p["slug"] != lead and takes_tasks(p)
            and word in (p["slug"].lower(), short_name(p).lower(), pane_label(p).lower().replace(" ", ""))]
    return hits[0] if len(hits) == 1 else None


def pane_list(ws):
    lead = lead_of_cached(ws)
    rows = circle_panes(ws)
    words = [short_name(p).lower() for p in rows]
    return [{"slug": p["slug"], "name": pane_label(p), "lead": p["slug"] == lead,
             "at": short_name(p) if words.count(short_name(p).lower()) == 1 else p["slug"],
             "helper": p["slug"] != lead and takes_tasks(p),
             "busy": p.get("activity") == "busy", "asleep": bool(p.get("asleep"))}
            for p in rows]


def peek(ws, slug):
    p = next((x for x in circle_panes(ws) if x["slug"] == slug), None)
    if not p:
        return None
    out = ctl("read", slug, "--all", "--lines", str(PEEK_LINES), timeout=15)
    return {"name": pane_label(p), "busy": p.get("activity") == "busy",
            "text": out.stdout if out.returncode == 0 else ""}


CTX = re.compile(r"\bctx:(\d+)%")


def lead_context(ws, ps):
    """How full the lead's Claude context is, off its status line, or None."""
    lead = lead_of_cached(ws)
    if not any(p["slug"] == lead and not p.get("asleep") for p in ps):
        return None
    hits = CTX.findall(ctl("read", lead, "--lines", "8", timeout=10).stdout)
    return int(hits[-1]) if hits else None


def stop_pane(ws, slug):
    """Esc stops Claude's turn. Only mid-turn: on a question Esc answers it, and that's
    the user's call to make from the question's own buttons. Returns why not, or None."""
    p = next((x for x in circle_panes(ws) if x["slug"] == slug), None)
    if not p:
        return "That pane isn't in this circle."
    name = pane_label(p)
    with pane_lock(slug):
        row = pane_row(slug)
        if not row or row.get("activity") != "busy":
            return f"{name} isn't working on anything."
        if stopped(row):
            return f"{name} is waiting on a question, so nothing was pressed."
        out = ctl("send-raw", slug, "\x1b")
    if out.returncode != 0:
        return f"Couldn't stop {name}: {(out.stderr or out.stdout).strip()[-200:]}"
    # Its open messages won't get an answer now: stop waiting, without a "no answer"
    # ping, but keep the watch so a late answer (after "keep going") still shows.
    with store.lock:
        waiting = [(int(k), r) for k, r in store.pending.items()
                   if r["pane"] == slug and store.msgs.get(int(k), {}).get("status") == "got"]
        for _, r in waiting:
            r["stopped"] = True
        store.save_pending()
        for mid, _ in waiting:
            store.set_status(mid, "stopped")
    _stopped_at[slug] = time.time()
    store.add(ws, "system", f"You stopped {name}.")
    threading.Thread(target=check_stopped, args=(ws, slug, name), daemon=True).start()
    return None


def check_stopped(ws, slug, name):
    time.sleep(STOP_CHECK)
    row = pane_row(slug)
    if row and row.get("activity") == "busy":
        store.add(ws, "system", f"{name} still looks busy. It may have started its next "
                                "queued task, or the running command ignored Esc.")


STOP_CHECK = 8
_stopped_at = {}  # pane -> when the user last stopped it


# ── search, forward, reminders ────────────────────────────────────────────

SEARCH_MAX = 50
SNIP = 70


def search(q):
    q = q.strip().lower()
    if len(q) < 2:
        return []
    names = dict(store.names or circles())
    names[ALERTS] = "Alerts"
    with store.lock:
        msgs = [dict(m) for m in reversed(list(store.msgs.values())) if m["ws"] in names]
    out = []
    for m in msgs:
        text = m.get("text") or ""
        title = (m.get("attachment") or {}).get("title", "")
        at = text.lower().find(q)
        if at < 0 and q not in title.lower():
            continue
        at = max(at, 0)
        snip = text[max(0, at - SNIP):at + SNIP].replace("\n", " ").strip()
        out.append({"ws": m["ws"], "circle": names[m["ws"]], "id": m["id"], "from": m["from"],
                    "ts": m["ts"], "text": ("…" if at > SNIP else "") + snip or title})
        if len(out) == SEARCH_MAX:
            break
    return out


def forward(mid, ws, device):
    """Send a message on to another circle's lead, as the user's own, pictures and file included."""
    with store.lock:
        m = dict(store.msgs.get(mid) or {})
    if not m or ws == ALERTS or ws not in circles():
        return None
    home = "Alerts" if m["ws"] == ALERTS else store.names.get(m["ws"]) or m["ws"]
    body = m.get("text") or ""
    msg = store.add(ws, "me", f"Forwarded from {home}:\n\n{body}".strip(), "sending",
                    images=m.get("images") or ([m["image"]] if m.get("image") else ()),
                    attachment=m.get("attachment"), device=device)
    threading.Thread(target=deliver, args=(msg,), daemon=True).start()
    return msg


REMINDERS = os.path.join(STATE, "reminders.json")
REMIND_POLL = 20
REMIND_MAX = 366 * 86400 * 1000
_remind_lock = threading.Lock()


def set_reminder(mid, at, lead, label):
    """Bring a message back at `at` (ms): to the user, or with lead=True to the circle's lead as a
    fresh message. Kept on disk, so a restart can't lose one; a late one fires when it can."""
    with store.lock:
        m = dict(store.msgs.get(mid) or {})
    now = time.time() * 1000
    if not m or not now < at < now + REMIND_MAX or (lead and m["ws"] == ALERTS):
        return False
    with _remind_lock:
        rows = read_json(REMINDERS, [])
        rows.append({"id": secrets.token_hex(4), "ws": m["ws"], "mid": mid, "at": at,
                     "lead": bool(lead), "text": m.get("text") or "(a photo or file)"})
        write_atomic(REMINDERS, json.dumps(rows))
    who = "the lead" if lead else "you"
    store.add(m["ws"], "system", f"Reminder set: this comes back to {who} {label[:40]}.")
    return True


def fire_reminder(r):
    ws, text = r["ws"], r["text"]
    with store.lock:
        m = dict(store.msgs.get(r["mid"]) or {})
    extra = {"images": m.get("images") or ([m["image"]] if m.get("image") else ()),
             "attachment": m.get("attachment")}
    if r["lead"]:
        msg = store.add(ws, "me", f"Pick this up now, as the user asked earlier:\n\n{text}", "sending", **extra)
        deliver(msg)
        return
    # store.add, not reply: an old message's choice: or run: line must not come back as a live button.
    store.add(ws, "system", f"Reminder:\n\n{text}", **extra)
    push(ws, "Alerts" if ws == ALERTS else store.names.get(ws) or ws, "Reminder: " + text)


def watch_reminders():
    while True:
        time.sleep(REMIND_POLL)
        try:
            now = time.time() * 1000
            with _remind_lock:
                rows = read_json(REMINDERS, [])
                due = [r for r in rows if r["at"] <= now]
                if due:  # off the list first: a crash can miss one, never repeat it
                    write_atomic(REMINDERS, json.dumps([r for r in rows if r["at"] > now]))
            for r in due:
                threading.Thread(target=fire_reminder, args=(r,), daemon=True).start()
        except Exception as e:
            print(f"watch_reminders: {e}", file=sys.stderr, flush=True)


