def vapid_key_path():
    path = os.path.join(CONF, "vapid.pem")
    if not os.path.exists(path):
        from py_vapid import Vapid01
        v = Vapid01()
        v.generate_keys()
        os.makedirs(CONF, exist_ok=True)
        v.save_key(path)
        os.chmod(path, 0o600)
    return path


def vapid_public():
    import base64
    from cryptography.hazmat.primitives import serialization
    from py_vapid import Vapid01
    raw = Vapid01.from_file(vapid_key_path()).public_key.public_bytes(
        serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)
    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode()


def b64d(s):
    import base64
    return base64.urlsafe_b64decode(s + "=" * (-len(s) % 4))


def encrypt(sub, payload):
    """RFC 8291 (aes128gcm) Web Push payload encryption. Hand-rolled on
    cryptography because pywebpush pulls in aiohttp and requests (about 30 MB
    more on a small server)."""
    from cryptography.hazmat.primitives import hashes, serialization
    from cryptography.hazmat.primitives.asymmetric import ec
    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
    from cryptography.hazmat.primitives.kdf.hkdf import HKDF

    def hkdf(salt, ikm, info, n):
        return HKDF(hashes.SHA256(), n, salt, info).derive(ikm)

    ua_pub, auth = b64d(sub["keys"]["p256dh"]), b64d(sub["keys"]["auth"])
    key = ec.generate_private_key(ec.SECP256R1())
    as_pub = key.public_key().public_bytes(
        serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)
    shared = key.exchange(ec.ECDH(), ec.EllipticCurvePublicKey.from_encoded_point(
        ec.SECP256R1(), ua_pub))
    ikm = hkdf(auth, shared, b"WebPush: info\0" + ua_pub + as_pub, 32)
    salt = os.urandom(16)
    cek = hkdf(salt, ikm, b"Content-Encoding: aes128gcm\0", 16)
    nonce = hkdf(salt, ikm, b"Content-Encoding: nonce\0", 12)
    body = AESGCM(cek).encrypt(nonce, payload + b"\x02", None)
    return salt + struct.pack(">IB", 4096, len(as_pub)) + as_pub + body


def send_push(sub, payload):
    """POST one notification; returns the push service's HTTP status."""
    from py_vapid import Vapid02
    endpoint = urlparse(sub["endpoint"])
    auth = Vapid02.from_file(vapid_key_path()).sign(
        {"aud": f"{endpoint.scheme}://{endpoint.netloc}", "sub": VAPID_SUBJECT,
         "exp": int(time.time()) + 12 * 3600})
    req = urllib.request.Request(sub["endpoint"], encrypt(sub, payload), {
        "Authorization": auth["Authorization"], "TTL": "86400", "Urgency": "high",
        "Content-Encoding": "aes128gcm", "Content-Type": "application/octet-stream"})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            return r.status
    except urllib.error.HTTPError as e:
        return e.code


MAC_ACTIVE_SECS = 180  # input on the Mac this recent means the user is at it
_mac_idle = [0.0, None]  # checked at, idle seconds (None: Mac unreachable)


def mac_active():
    """The user is using the Mac: keyboard or trackpad within MAC_ACTIVE_SECS and AFK mode off.
    They read Seance's Chat there, so the phone stays quiet. Cached 30 s;
    an asleep or offline Mac counts as away."""
    if not MAC_SSH_TARGET or afk_state().get("on"):
        return False
    if time.time() - _mac_idle[0] > 30:
        try:
            out = mac_run("/usr/sbin/ioreg -c IOHIDSystem | awk '/HIDIdleTime/ {print int($NF/1000000000); exit}'",
                          capture_output=True, text=True, timeout=10).stdout.strip()
            _mac_idle[1] = int(out) if out.isdigit() else None
        except Exception:
            _mac_idle[1] = None
        _mac_idle[0] = time.time()
    return _mac_idle[1] is not None and _mac_idle[1] < MAC_ACTIVE_SECS


def push(ws, title, body):
    """Notify every subscribed phone. Urgent, so Android's battery saver
    doesn't hold it; gone subscriptions (404/410) are dropped. Skipped while
    the user is at the Mac, except the Alerts thread."""
    if ws != ALERTS and mac_active():
        return 0
    data = json.dumps({"ws": ws, "title": title, "body": body[:240],
                       "unread": store.total_unread()}).encode()
    dead, sent = [], 0
    for sub in list(store.subs):
        try:
            code = send_push(sub, data)
        except Exception as e:
            print(f"push: {e}", file=sys.stderr, flush=True)
            continue
        if code < 300:
            sent += 1
        elif code in (404, 410):
            dead.append(sub)
        elif code >= 300:
            print(f"push: HTTP {code} from {urlparse(sub['endpoint']).netloc}",
                  file=sys.stderr, flush=True)
    if dead:
        with store.lock:
            store.subs = [s for s in store.subs if s not in dead]
            store.save_subs()
    return sent


_asks_lock = threading.Lock()


def save_ask(mid, ask):
    with _asks_lock:
        asks = read_json(ASKS, {})
        asks[str(mid)] = ask
        write_atomic(ASKS, json.dumps(dict(list(asks.items())[-200:])))
    # Marked on the message too: once its ask ages out, a tap must not reach the lead as text.
    with store.lock:
        if mid in store.msgs:
            store.msgs[mid]["asked"] = True
            store._append({"id": mid, "asked": True})


def pr_rows():
    """The user's open PRs with their checks and review state, in one query."""
    query = ("""{search(query:"is:pr is:open author:AUTHOR archived:false",type:ISSUE,first:100){nodes{
      ... on PullRequest{number title url isDraft reviewDecision repository{nameWithOwner}
      commits(last:1){nodes{commit{statusCheckRollup{state}}}}}}}}""").replace("AUTHOR", PR_AUTHOR)
    env = {k: v for k, v in os.environ.items() if k != "GITHUB_TOKEN"}
    out = subprocess.run([GH, "api", "graphql", "-f", "query=" + query], capture_output=True, text=True,
                         env=env, timeout=60, check=True).stdout
    rows = []
    for n in json.loads(out)["data"]["search"]["nodes"]:
        commits = n["commits"]["nodes"]
        checks = commits[0]["commit"]["statusCheckRollup"] if commits else None
        rows.append({"repo": n["repository"]["nameWithOwner"], "number": n["number"], "title": n["title"],
                     "url": n["url"], "draft": n["isDraft"], "review": n["reviewDecision"],
                     "checks": checks["state"] if checks else None})
    return rows


def file_prs(rows):
    """Which circle each PR belongs to: a best guess from where its link appears in a circle's project
    folder (see CIRCLES_MAP). The shared circle, if any, only keeps the PRs no other circle claims.
    With no map, every PR is filed under the Alerts thread."""
    claims = {}
    for line in (SPEC_MAP.read_text().splitlines() if SPEC_MAP else []):
        ws, _, folder = line.partition("\t")
        if not folder or ws.startswith("#"):
            continue
        for path in (SPEC_MAP.parent / folder.strip()).glob("*.md"):
            for repo, number in PR_URL.findall(path.read_text(errors="replace")):
                claims.setdefault((repo.lower(), int(number)), set()).add(ws)
    filed = {}
    for pr in rows:
        homes = claims.get((pr["repo"].lower(), pr["number"]), set())
        for ws in (homes - {PM_CIRCLE} or homes or {ALERTS}):
            filed.setdefault(ws, []).append(pr)
    return filed


def watch_prs():
    global pr_cache
    while True:
        try:
            pr_cache = file_prs(pr_rows())
            write_atomic(PRS, json.dumps(pr_cache))
        except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as e:
            print(f"prs: {e}", file=sys.stderr, flush=True)  # keep showing the last good list
        time.sleep(PR_EVERY)


def save_spec(ws, m):
    """Go on a spec card: keep what was agreed in the circle's project folder (CIRCLES_MAP), newest first."""
    if not m.get("spec") or not SPEC_MAP:
        return
    try:
        rows = dict(l.split("\t", 1) for l in SPEC_MAP.read_text().splitlines()
                    if "\t" in l and not l.startswith("#"))
        folder = rows.get(ws)
        if not folder:
            return
        path = SPEC_MAP.parent / folder.strip() / "SPECS.md"
        body = m["text"].split("\n", 1)[1].strip() if "\n" in m["text"] else ""
        when = time.strftime("%Y-%m-%d %H:%M")
        old = path.read_text() if path.exists() else "# Specs\n\nApproved in chat, newest first.\n\n"
        head, _, rest = old.partition("## ")
        path.write_text(f"{head}## {when}: {m['spec']}\n\n{body}\n\n" + ("## " + rest if rest else ""))
    except OSError as e:
        print(f"spec not saved: {e}", file=sys.stderr, flush=True)


def reply(ws, text, who="lead", wait=False, mac=False, prefix="", to=""):
    """Add a message and notify. wait=True pushes inline and returns how many
    phones took it (alerts need to know). An `image:` line becomes a picture, fetched
    from the Mac first when mac=True; prefix names a pane that isn't the lead, and to
    is its slug, where its buttons send their answers."""
    text, images = take_images(text, mac)
    # A button goes back to the pane that offered it, so a pane we can't name gets none.
    runs = {RUN_LABEL + "".join(c): "".join(c) for c in RUN_LINE.findall(text or "")} if not prefix or to else {}
    choices = (list(runs) + [c.strip() for c in CHOICE_LINE.findall(text or "")])[:MAX_CHOICES]
    # The title stays as the first line, so a client that doesn't draw cards still reads it.
    spec = SPEC_LINE.search(text or "")
    spec = spec.group(1).strip() if spec else None
    if spec:
        text = spec + "\n" + SPEC_LINE.sub("", text, count=1).strip()
        choices = choices or list(SPEC_CHOICES)
    if choices:
        text = CHOICE_LINE.sub("", RUN_LINE.sub("", text) if runs else text)
        text = re.sub(r"\n{3,}", "\n\n", text).strip()
    if prefix:
        text = f"{prefix}: {text}" if text else prefix
    m = store.add(ws, who, text, images=images, choices=choices, spec=spec)
    if to and choices:
        save_ask(m["id"], {"run": runs, "to": to, "guest": prefix})
    elif runs:
        save_ask(m["id"], {"run": runs})
    name = "Alerts" if ws == ALERTS else store.names.get(ws) or circles().get(ws, ws)
    text = text or "Sent an image"
    if wait:
        return push(ws, name, text)
    threading.Thread(target=push, args=(ws, name, text), daemon=True).start()


def take_images(text, mac_first=False):
    """Pull every `image: /path` line out of a lead's text (a note can show several) and copy
    each file into FILES. Returns the text without the lines that worked, and the file names."""
    names, kept, last = [], [], 0
    for m in IMAGE_LINE.finditer(text or ""):
        name = fetch_image(m, mac_first)
        if name:
            names.append(name)
            kept.append(text[last:m.start()])
            last = m.end()
    if not names:
        return text, []
    rest = ("".join(kept) + text[last:]).strip()
    return re.sub(r"\n{3,}", "\n\n", rest), names


def fetch_image(m, mac_first):
    """Copy the file an `image:` line names into FILES, looking on the sender's machine first
    (else this machine, then the Mac). Returns its name in FILES, or None."""
    src = m.group(1)
    # The same line can carry a video (a render to watch on the phone).
    limit = MAX_VIDEO if m.group(2).lower() in ("mp4", "webm", "mov") else MAX_IMAGE
    name = secrets.token_hex(8) + (".jpg" if m.group(2).lower() == "jpeg" else "." + m.group(2).lower())
    dest = os.path.join(FILES, name)
    os.makedirs(FILES, exist_ok=True)

    def here():
        path = os.path.expanduser(src)
        if not os.path.isfile(path) or os.path.getsize(path) > limit:
            return False
        with open(path, "rb") as f, open(dest, "wb") as out:
            shutil.copyfileobj(f, out)
        return True

    def mac():
        if not MAC_SSH:
            return False
        cat = "cat ~/" + shlex.quote(src[2:]) if src.startswith("~/") else "cat " + shlex.quote(src)
        with open(dest, "wb") as out:
            ok = mac_run(f"{cat} | head -c {limit + 1}", stdout=out,
                         stderr=subprocess.DEVNULL, timeout=600 if limit == MAX_VIDEO else 30).returncode == 0
        return ok and 0 < os.path.getsize(dest) <= limit

    try:
        for get in ((mac, here) if mac_first else (here, mac)):
            if get():
                return name
    except (OSError, subprocess.TimeoutExpired):
        pass
    if os.path.exists(dest):
        os.remove(dest)
    return None


def on_mac(row):
    """Optional: panes whose name carries MAC_PANE_TAG run on the Mac, so photos are copied there."""
    return bool(MAC_SSH_TARGET) and MAC_PANE_TAG in ((row or {}).get("name") or "")


# Where the user typed a message.
# Seance's Chat layout talks to Invoke with curl; the phone is the installed Android app.
DEVICES = {
    "phone": {"where": "on their phone (Invoke)", "reading": "on their phone"},
    "mac": {"where": "in Seance's Chat on their Mac (Invoke)", "reading": "in Seance's Chat on their Mac"},
    "browser": {"where": "in a browser (Invoke)", "reading": "in a browser"},
}


def device_of(user_agent):
    ua = user_agent or ""
    if ua.startswith("curl/"):
        return "mac"
    return "phone" if "Android" in ua or "Mobile" in ua else "browser"


def device_words(msg):
    return DEVICES.get(msg.get("device"), DEVICES["phone"])


def lead_text(msg, mac):
    """What the lead reads: the user's words, plus where their photo is. A Mac lead (mac=True) can't
    read this machine's disk, so the photo is copied to the Mac first (skipped if it's asleep)."""
    if msg.get("attachment"):
        return doc_text(msg, mac)
    if not msg.get("image"):
        return msg["text"]
    where, video = [], False
    for name in msg.get("images") or [msg["image"]]:  # a forward can carry several
        path = os.path.join(FILES, name)
        video = video or os.path.splitext(path)[1] in VIDEO_TYPES.values()
        where.append(f"On this machine: {path}")
        if mac:
            try:
                with open(path, "rb") as f:
                    if mac_run(f"mkdir -p {MAC_FILES} && cat > {MAC_FILES}/{name}",
                               stdin=f, stderr=subprocess.DEVNULL, timeout=600 if video else 60).returncode == 0:
                        where.append(f"On the Mac: {MAC_FILES}/{name}")
            except (OSError, subprocess.TimeoutExpired):
                pass
    if video:
        return ((msg["text"] or "(no message, just the video)") +
                "\n\nThe user sent a video. To look at it, pull frames with ffmpeg and Read them:\n" + "\n".join(where))
    return ((msg["text"] or "(no message, just the photo)") +
            "\n\nThe user sent a photo. Look at it with the Read tool:\n" + "\n".join(where))


def doc_text(msg, mac):
    """The same for a document: where it is, with the user's file name."""
    doc = msg["attachment"]
    path = os.path.join(FILES, doc["file"])
    where = [f"On this machine: {path}"]
    if mac:
        try:
            with open(path, "rb") as f:
                if mac_run(f"mkdir -p {MAC_FILES} && cat > {MAC_FILES}/{doc['file']}",
                           stdin=f, stderr=subprocess.DEVNULL, timeout=120).returncode == 0:
                    where.append(f"On the Mac: {MAC_FILES}/{doc['file']}")
        except (OSError, subprocess.TimeoutExpired):
            pass
    return f"{msg['text']}\n\nThe user sent a file named {doc['title']}:\n" + "\n".join(where)


def afk_state():
    """afk's marks here: on since when (ignored after 12 h, like the prompt gate) and whether
    the Mac is being kept awake."""
    try:
        with open(os.path.join(AFK_DIR, "on")) as f:
            since = int(f.read().strip() or 0)
    except (OSError, ValueError):
        return {"on": False}
    if time.time() - since > 12 * 3600:
        return {"on": False}
    return {"on": True, "since": since * 1000, "mac": os.path.exists(os.path.join(AFK_DIR, "mac-awake"))}


def usage_state():
    """5 hour and weekly plan use (any tool can write USAGE_FILE), with reset times in ms. A window whose
    reset has passed reads 0 until a pane hears the new one."""
    try:
        with open(USAGE) as f:
            u = json.load(f)
    except (OSError, ValueError):
        return None
    out = {}
    for w in ("five_hour", "seven_day"):
        r = u.get(w)
        if r:
            past = r["resets_at"] <= time.time()
            out[w] = {"used": 0 if past else r["used"], "resets": None if past else r["resets_at"] * 1000}
    return out or None


def afk_said(cmd):
    if not AFK:
        return ("afk isn't installed. Put the kit's afk/afk script next to seance-chat, on your PATH, "
                "or set AFK_BIN in config.env.")
    try:
        out = subprocess.run([AFK, cmd, "--no-text"], capture_output=True, text=True, timeout=60)
        return (out.stdout or out.stderr).strip() or f"afk {cmd} failed"
    except (OSError, subprocess.TimeoutExpired) as e:
        return f"afk {cmd} failed: {e}"


def run_afk(ws, cmd):
    """`afk` sent in any thread runs afk here instead of reaching the lead."""
    reply(ws, afk_said(cmd), "system")


# ── delivery ──────────────────────────────────────────────────────────────

def pane_lock(pane):
    with _locks_guard:
        return _pane_locks.setdefault(pane, threading.Lock())


def deliver(msg):
    try:
        _deliver(msg)
    except Exception as e:
        print(f"deliver {msg['ws']}: {e}", file=sys.stderr, flush=True)
        store.set_status(msg["id"], "failed")
        if msg.get("offer") and not msg.get("typed"):
            store.unpick(msg["offer"])
        reply(msg["ws"], f"Couldn't send that: {e}", "system")


def _deliver(msg):
    ws = msg["ws"]
    pane = msg.get("pane") or lead_of(ws)  # @name in a message goes to that helper
    if not pane:
        store.set_status(msg["id"], "failed")
        if msg.get("offer"):
            store.unpick(msg["offer"])
        reply(ws, "This circle has no live lead right now. If its lead is on the Mac, "
                  "the Mac may be asleep; send again once it's awake.", "system")
        return
    if msg.get("guest"):  # a helper can close, or its slug go to a new pane, after its button was posted
        row = pane_row(pane)
        if not row or row.get("workspace") != ws or row.get("exited") or not takes_tasks(row):
            store.set_status(msg["id"], "failed")
            if msg.get("offer"):
                store.unpick(msg["offer"])
            reply(ws, f"{msg['guest']} isn't available in this circle anymore, so nothing was sent.", "system")
            return
    if msg.get("run"):
        run_in_pane(msg, pane, msg["run"])
        return
    # A busy lead would only see a task after its whole job: hand it a note
    # mid-turn instead, the way the user's typed messages arrive (the ask,
    # 2026-10-27). An idle lead gets a normal task.
    row = pane_row(pane)
    # The lead is stopped on a question with a free-text option: their typed
    # message is the answer. Only one they sent just now:
    # a reminder or a forward knows nothing of a question on the screen.
    if row and msg.get("live") and stopped(row) and typed_answer(msg, pane):
        return
    if row and row.get("activity") == "busy" and note_lead(msg, pane):
        return
    queue_task(msg, pane)


def queue_task(msg, pane):
    ws = msg["ws"]
    # One send at a time per pane, so two quick sends reach it in order.
    # --queue waits while the pane works; an idle pane gets it now.
    body = TASK.format(text=lead_text(msg, on_mac(pane_row(pane))), **device_words(msg))
    seen = login_lines(pane)
    with pane_lock(pane):
        before = len(pad_text(pane))
        with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False) as f:
            f.write(body)
            path = f.name
        try:
            out = ctl("send", pane, "--queue", "--file", path)
        finally:
            os.unlink(path)
    m = re.search(r"task=(\S+)", out.stdout)
    if out.returncode != 0 or not m:
        store.set_status(msg["id"], "failed")
        reply(ws, f"Couldn't hand that to {pane}: "
                  f"{(out.stderr or out.stdout).strip()[-300:]}", "system")
        return
    rec = {"ws": ws, "pane": pane, "task": m.group(1), "before": before,
           "until": time.time() + WAIT_SECS, "guest": msg.get("guest", "")}
    with store.lock:
        store.pending[str(msg["id"])] = rec
        store.save_pending()
    threading.Thread(target=watch_login, args=(msg["id"], rec, seen), daemon=True).start()
    threading.Thread(target=watch_ack, args=(msg["id"], rec), daemon=True).start()
    await_answer(msg["id"], rec)


ACK_POLL = 3


def watch_ack(mid, rec):
    """Hold the user's note at one tick (sending) until the lead starts its task, then
    two (got): the second tick means the lead has seen it."""
    while time.time() < rec["until"]:
        with store.lock:
            if str(mid) not in store.pending:
                return  # answered first
        try:
            row = pane_row(rec["pane"]) or {}
            if row.get("task_id") == rec["task"] and row.get("task_status") == "open":
                with store.lock:
                    if store.msgs.get(mid, {}).get("status") == "sending":
                        store.set_status(mid, "got")
                return
        except Exception as e:
            print(f"watch_ack {rec['pane']}: {e}", file=sys.stderr, flush=True)
        time.sleep(ACK_POLL)


# Claude Code's own error line when its login runs out; the lead then can't
# answer. Anchored to a line start so an echoed message or a grep can't match.
LOGIN_GONE = re.compile(r"^\s*(?:[⎿⏺●]\s*)?(?:Login expired · Please run /login|API Error: 401)", re.M)
LOGIN_POLL = 20
_login_told = {}  # pane -> when the user was last told, so a burst of messages gets one notice


def login_lines(pane):
    """How many expiry lines the pane's screen shows; 0 when it can't be read."""
    try:
        out = ctl("read", pane, "--lines", "40", timeout=10)
    except (subprocess.SubprocessError, OSError):
        return 0
    return len(LOGIN_GONE.findall(out.stdout)) if out.returncode == 0 else 0


def watch_login(mid, rec, seen):
    """While a task waits, tell the user in the thread if the lead's Claude login
    has expired, instead of going quiet for hours.
    `seen` is how many expiry lines were on screen before the send."""
    while time.time() < rec["until"]:
        time.sleep(LOGIN_POLL)
        with store.lock:
            if str(mid) not in store.pending:
                return
        try:
            now = login_lines(rec["pane"])
            if now <= seen:
                seen = min(seen, now)  # old lines scrolled off: count from here
                continue
            with _used_lock:
                if time.time() - _login_told.get(rec["pane"], 0) < 600:
                    return
            row = pane_row(rec["pane"]) or {}
            name = row.get("name") or rec["pane"]  # e.g. "Reviewer · Mac"
            reply(rec["ws"], f"{name} can't answer: its Claude login expired. "
                  "Run /login in that pane, then send your message again.", "system")
            with _used_lock:
                _login_told[rec["pane"]] = time.time()
            return
        except Exception as e:
            print(f"watch_login {rec['pane']}: {e}", file=sys.stderr, flush=True)


NOTE = """\U0001F4F1 The user, {where}, while you're working:

{text}

---
Answer them now, then carry on with what you were doing. Reply with a pad note whose first line is only \U0001F4F1 (that line tells their chat it's the answer):
seance ctl note --stdin <<'PHONE_REPLY'
\U0001F4F1
<short plain answer; links as full https URLs>
PHONE_REPLY
If it needs real work, say so in the answer and do it after your current job.
To show them an image, put a line `image: /absolute/path.png` in the note.
To ask them to pick, add `choice: <answer>` lines (up to 6, your pick first); they tap one.
Before handing work to another pane, or doing anything wider than their literal words, send a `spec: <title>` line with 3 to 5 short lines and stop; they tap Go or Change. Exact asks skip it.
Never tell them to type something in a terminal: a command that needs them goes on its own line as `run: <command>`, a button that runs it in your pane.
"""
STAMP = re.compile(r"^-{3,}\s*\n<!-- [^\n]*-->[ \t]*\n", re.M)
IDLE_FALLBACK = 45  # lead stopped without a phone note: send it as a task


def pane_row(slug):
    return next((p for p in panes() if p["slug"] == slug), None)


def note_lead(msg, pane):
    body = NOTE.format(text=lead_text(msg, on_mac(pane_row(pane))), **device_words(msg))
    with pane_lock(pane):
        before = len(pad_text(pane))
        # Claim the pane's next phone note before pasting: the lead can answer
        # while note-agent is still returning, and the pad watcher would post
        # that answer loose, so every later note answered the message before
        # it and the last one came back again as a task.
        rec = {"kind": "note", "ws": msg["ws"], "pane": pane, "before": before,
               "at": time.time(), "until": time.time() + WAIT_SECS, "guest": msg.get("guest", "")}
        with store.lock:
            store.pending[str(msg["id"])] = rec
            store.save_pending()
        with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False) as f:
            f.write(body)
            path = f.name
        try:
            rc = ctl("note-agent", pane, "--file", path, timeout=90).returncode
        except subprocess.TimeoutExpired:
            rc = 3
        except Exception as e:  # anything else: unclaim below, or the pad watcher skips this pane
            print(f"note-agent {pane}: {e}", file=sys.stderr, flush=True)
            rc = -1
        finally:
            os.unlink(path)
    # 3 (EXIT_UNDELIVERED) and a timeout come after the paste: it likely
    # landed, so watch for the answer (the idle fallback still catches a
    # miss). Anything else failed before pasting: send it as a task.
    if rc not in (0, 3):
        print(f"note-agent {pane}: exit {rc}", file=sys.stderr, flush=True)
        with store.lock:
            store.pending.pop(str(msg["id"]), None)
            store.save_pending()
        return False
    store.set_status(msg["id"], "got", mode="note")
    await_note(msg["id"], rec)
    return True


def phone_note(pane, pad, before):
    """The first pad note since `before` that starts with the phone marker
    and hasn't been shown yet, without the marker; None when there's none."""
    if len(pad) < before:
        before = max(0, len(pad) - 3500)
    stamps = list(STAMP.finditer(pad, before))
    with _used_lock:
        used = _used.setdefault(pane, set())
        for i, m in enumerate(stamps):
            end = stamps[i + 1].start() if i + 1 < len(stamps) else len(pad)
            body = pad[m.end():end].strip()
            if seen_key(m) not in used and body.startswith("\U0001F4F1"):
                used.add(seen_key(m))
                save_used()
                return body[1:].strip()
    return None


def await_note(mid, rec):
    handed_off = False
    try:
        handed_off = _await_note(mid, rec)
    finally:
        if not handed_off:
            with store.lock:
                store.pending.pop(str(mid), None)
                store.save_pending()


def _await_note(mid, rec):
    """Watch the lead's pad for its phone note. If the lead goes idle without
    one, the message becomes a normal task so it's never dropped."""
    idle_since = None
    while time.time() < rec["until"]:
        # The note pasted first claims the next answer, so two notes can't
        # swap answers (paste order, not message id: two sends can race for
        # the pane lock).
        with store.lock:
            older = any(r.get("kind") == "note" and r["pane"] == rec["pane"] and int(k) != mid
                        and ((r.get("at", 0), int(k)) < (rec.get("at", 0), mid)
                             or (rec.get("stopped") and not r.get("stopped")))
                        and not (r.get("stopped") and not rec.get("stopped"))
                        for k, r in store.pending.items())
        text = None if older else phone_note(rec["pane"], pad_text(rec["pane"]),
                                              rec["before"])
        if text is not None:
            with store.lock:  # Send now checks pending under this lock
                store.pending.pop(str(mid), None)
                store.save_pending()
                now = rec.get("now") and not rec.get("stopped")
            store.set_status(mid, "answered")
            _no_answer.pop(rec["pane"], None)
            reply(rec["ws"], text or f"{rec['pane']} sent an empty answer.",
                  mac=on_mac(pane_row(rec["pane"])), prefix=rec.get("guest", ""),
                  to=rec["pane"] if rec.get("guest") else "")
            if now:
                resume_lead(rec["pane"])
            return False
        row = pane_row(rec["pane"])
        # Only a truly idle lead starts the fallback clock: a permission
        # prompt or a daemon restart (no row) isn't the lead ignoring us.
        if not row or row.get("activity") != "idle" or rec.get("stopped"):
            idle_since = None
        elif idle_since is None:
            idle_since = time.time()
        elif time.time() - idle_since > IDLE_FALLBACK:
            msg = dict(store.msgs[mid], guest=rec.get("guest", ""))
            with store.lock:
                store.pending.pop(str(mid), None)
                store.save_pending()
            queue_task(msg, rec["pane"])
            if rec.get("now") and not rec.get("stopped"):
                resume_lead(rec["pane"])
            return True
        time.sleep(4)
    if not rec.get("stopped"):
        store.set_status(mid, "failed")
        no_answer(rec, f"No answer from {rec['pane']} after 3 hours.")
    return False


NOW = ("(the user tapped Send now on their phone message above. Answer it now with the "
       "\U0001F4F1 pad note, then carry on with your task.)")


def send_now(mid):
    """Interrupt the lead's turn so a waiting phone note is read at once
    (`note-agent --interrupt` cancels the running tool call)."""
    with store.lock:
        rec = store.pending.get(str(mid))
        if not rec or rec.get("kind") != "note":
            return "That message is already answered or queued as a task."
        rec["now"] = True  # before the interrupt: the answer may land during it
        store.save_pending()
        store.set_status(mid, "got", mode="now")
    out = ctl("note-agent", rec["pane"], "--interrupt", NOW, timeout=90)
    if out.returncode not in (0, 3):
        # Refused (e.g. a permission prompt): back to a plain waiting note,
        # so the button returns and no "carry on" is sent later.
        with store.lock:
            if str(mid) in store.pending:
                rec["now"] = False
                store.save_pending()
                store.set_status(mid, "got", mode="note")
        return f"Couldn't interrupt {rec['pane']}: {(out.stderr or out.stdout).strip()[-200:]}"
    return None


def resume_lead(pane):
    """An interrupt ends the lead's turn after it answers: once it goes idle
    (it may still be wrapping up), start it again, unless the user stopped it meanwhile."""
    start = time.time()
    for _ in range(30):
        time.sleep(4)
        if _stopped_at.get(pane, 0) >= start:
            return
        row = pane_row(pane)
        if row and row.get("activity") == "idle":
            ctl("note-agent", pane, "Thanks. Carry on with what you were doing before "
                "the user's phone message.", timeout=90)
            return


FINISH = re.compile(r"^-{3,}\s*\n<!-- [^\n]*· finish -->[ \t]*\n", re.M)
USED = os.path.join(STATE, "used.json")
# pane -> pad offsets of answers already shown; saved so a restart can't
# show one twice.
_used = {k: {x for x in v if isinstance(x, str)} for k, v in read_json(USED, {}).items()}
_used_lock = threading.Lock()
_arrange_lock = threading.Lock()


def seen_key(m):
    """An answer's identity: its pad position plus its stamp line (which
    carries a time), so a pad that shrank and regrew can't hide a new one."""
    return f"{m.start()}|{m.group(0).strip()}"


def save_used():
    write_atomic(USED, json.dumps({k: sorted(v) for k, v in _used.items()}))


def answer_from(pane, pad, before):
    """This task's answer: the newest finish since the send that no other
    phone message has taken. The wait returns right after this task's own
    finish, so the newest one is it even when a desktop task finished first;
    the stamp line itself stays out of the bubble."""
    if len(pad) < before:  # pad rewritten mid-task: fall back to its tail
        before = max(0, len(pad) - 3500)
    stamps = list(FINISH.finditer(pad, before))
    with _used_lock:
        used = _used.setdefault(pane, set())
        for i in reversed(range(len(stamps))):
            m = stamps[i]
            if seen_key(m) in used:
                continue
            used.add(seen_key(m))
            save_used()
            end = stamps[i + 1].start() if i + 1 < len(stamps) else len(pad)
            return pad[m.end():end].strip()
    return pad[before:].strip()


RETRY = re.compile(r"cannot connect|has exited|no pane|not running", re.I)
NO_ANSWER_QUIET = 12 * 3600
_no_answer = {}  # pane -> when its last "no answer" pinged the user


REPEAT_SECS = 120
_last_answer = {}  # pane -> (answer text, when)


def repeat_answer(pane, text):
    """Whether this answer is the one the pane just gave: a lead closing a backlog of
    tasks finishes each with the same line, and one bubble says it all."""
    last = _last_answer.get(pane)
    _last_answer[pane] = (text, time.time())
    return len(text) > 20 and bool(last) and last[0] == text and time.time() - last[1] < REPEAT_SECS


def no_answer(rec, text):
    """One ping per pane: a pane that can't finish fails every waiting message, so
    after the first the rest only land in the thread, until it answers one again."""
    if time.time() - _no_answer.get(rec["pane"], 0) < NO_ANSWER_QUIET:
        store.add(rec["ws"], "system", text)
        return
    _no_answer[rec["pane"]] = time.time()
    reply(rec["ws"], text, "system")


def await_answer(mid, rec):
    try:
        _await_answer(mid, rec)
    finally:
        with store.lock:
            store.pending.pop(str(mid), None)
            store.save_pending()


def _await_answer(mid, rec):
    # Retry until the deadline when `ctl wait` gives up for a passing reason:
    # the daemon socket is away (a Seance upgrade, a restart, boot)
    # or a Mac lead looks offline. A cancelled or failed task fails at once.
    while True:
        left = int(rec["until"] - time.time())
        if left <= 0:
            if not rec.get("stopped"):
                store.set_status(mid, "failed")
                no_answer(rec, f"No answer from {rec['pane']} after 3 hours.")
            break
        w = ctl("wait", rec["pane"], "--task", rec["task"], "--status", "done",
                "--timeout", str(left), timeout=left + 60)
        if w.returncode == 0:
            text = answer_from(rec["pane"], pad_text(rec["pane"]), rec["before"])
            store.set_status(mid, "answered")
            _no_answer.pop(rec["pane"], None)
            if not repeat_answer(rec["pane"], text):
                reply(rec["ws"], text or f"{rec['pane']} finished without writing an answer.",
                      mac=on_mac(pane_row(rec["pane"])), prefix=rec.get("guest", ""),
                      to=rec["pane"] if rec.get("guest") else "")
            break
        why = (w.stderr or w.stdout).strip()[-200:]
        if w.returncode != 2 and not RETRY.search(why):
            if not rec.get("stopped"):
                store.set_status(mid, "failed")
                no_answer(rec, f"No answer from {rec['pane']} ({why or 'wait failed'}).")
            break
        print(f"wait {rec['pane']} {rec['task']}: {why}", file=sys.stderr, flush=True)
        time.sleep(15)


# ── texts a lead starts ("text me") ───────────────────────────────────────

WATCH = os.path.join(STATE, "watch.json")
WATCH_SECS = 5


def watch_texts():
    """Any pane, on this machine or the Mac, texts the user with a pad note whose
    first line is only the phone marker. Poll `ctl list` and read only pads
    whose rev moved; each pad's read position is saved so a restart neither
    misses nor repeats a text."""
    seen = read_json(WATCH, {})  # pane -> {"rev": n, "len": chars read}
    afk = layout = None
    while True:
        try:
            _watch_once(seen)
        except Exception as e:
            print(f"watch: {e}", file=sys.stderr, flush=True)
        # AFK flips outside this server (a pane, the Mac's watcher): redraw the phone's top bar.
        if afk_state() != afk:
            afk = afk_state()
            with store.lock:
                store._bump()
        # Circles reordered or moved in Seance: redraw the phone's list in the new order.
        now = spaces()
        if now != layout:
            layout = now
            with store.lock:
                store._bump()
        time.sleep(WATCH_SECS)


def _watch_once(seen):
    changed = False
    rows = [p for p in panes() if p.get("kind") == "terminal"]
    with store.lock:
        waiting = {r["pane"] for r in store.pending.values() if r.get("kind") == "note"}
    for p in rows:
        needs_you(p)
        slug, rev = p["slug"], p.get("pad_rev")
        old = seen.get(slug)
        if old and old["rev"] == rev:
            continue
        if slug in waiting:  # its phone reply is the waiting note's to claim
            continue
        pad = pad_text(slug)
        start = old["len"] if old and old["len"] <= len(pad) else len(pad)
        if old:  # first sight of a pane: start from now, don't replay history
            for text in new_texts(slug, pad, start):
                lead = lead_of_cached(p["workspace"])
                prefix = "" if slug == lead else pane_label(p)
                args = (p["workspace"], text, "lead", False, on_mac(p), prefix, slug if prefix else "")
                if IMAGE_LINE.search(text):  # fetching it can take a while; don't hold up other panes
                    threading.Thread(target=reply, args=args, daemon=True).start()
                else:
                    reply(*args)
        seen[slug] = {"rev": rev, "len": len(pad)}
        changed = True
    if changed:
        write_atomic(WATCH, json.dumps(seen))


NEEDS = os.path.join(STATE, "needs.json")
NEEDS_HOLD = 3 * 3600  # how long a posted prompt is remembered once its pane stops showing it
NEEDS_BLANK = 15  # a stop with no readable prompt waits this long for one before posting
_needs = {k: {**v, "seen": time.time()} for k, v in read_json(NEEDS, {}).items()}  # pane -> last posted prompt
_blank = {}  # pane -> when it stopped with no readable prompt


def stopped(p):
    """Waiting on the user: Claude's needs-human hook, or a prompt Seance sees on screen
    before Claude is even running (the folder-trust check on wake)."""
    return not p.get("asleep") and (p.get("status") == "needs-human"
                                    or p.get("activity") == "awaiting-input")
ASKS = os.path.join(STATE, "asks.json")  # message id -> the pane prompt it mirrors
OPTION = re.compile(r"^\s*(?:[\u276f\u203a>]\s*)?(\d)\.\s+(.+?)\s*$")
BOX = re.compile(r"^\s*\u2502 ?|\s*\u2502\s*$")  # a boxed prompt's side borders
RULE = re.compile(r"^[\s\u2500\u2501\u256d\u256e\u2570\u256f-]*$")  # blank, or a box/separator rule
SOLID = re.compile(r"^\s*[\u2500\u2501]{20,}\s*$")  # the rule above a prompt


def screen_lines(slug):
    try:
        out = ctl("read", slug, "--lines", "40", timeout=10)
    except (subprocess.SubprocessError, OSError):
        return []
    return [BOX.sub("", l) for l in out.stdout.splitlines()] if out.returncode == 0 else []


def prompt_in(lines):
    """The prompt on a stopped pane's screen: (the lines above its numbered options,
    [(key, label)]). Claude's permission prompts and questions pick by digit."""
    end = max((n for n, l in enumerate(lines) if OPTION.match(l)), default=-1)
    if end < 0 or end < len(lines) - 15:  # a numbered list far up is the chat, not a prompt
        return menu_on_screen(lines)
    start = end
    # Up through the options, their indented descriptions or wrapped labels and
    # separators, to the question line.
    while start > 0 and (OPTION.match(lines[start - 1]) or RULE.match(lines[start - 1])
                         or lines[start - 1].startswith("    ")):
        start -= 1
    opts = [(m.group(1), m.group(2)) for m in map(OPTION.match, lines[start:end + 1]) if m]
    above = [l.strip() for l in lines[max(0, start - 12):start] if not RULE.match(l)]
    return "\n".join(above[-8:])[-600:], opts[:6]


CURSOR = re.compile(r"^\s*\u276f\s+(\S.*?)\s*$")


def menu_on_screen(lines):
    """A menu without numbers, picked with the arrow keys and Enter (Claude's
    "trust this folder?" check when a pane wakes in a new folder). Keys are
    "m<option>:<cursor>", turned into arrow presses when the user taps."""
    tail = lines[-15:]
    if not any("Enter to confirm" in l or "Enter to select" in l for l in tail):
        return "", []
    at = next((n for n in range(len(tail) - 1, -1, -1) if CURSOR.match(tail[n])), None)
    if at is None:
        return "", []
    start = end = at
    while start > 0 and tail[start - 1].strip() and not RULE.match(tail[start - 1]):
        start -= 1
    while end + 1 < len(tail) and tail[end + 1].strip() and not RULE.match(tail[end + 1]):
        end += 1
    labels = [CURSOR.sub(r"\1", l).strip() for l in tail[start:end + 1]]
    opts = [(f"m{i}:{at - start}", label) for i, label in enumerate(labels)]
    head = lines[:len(lines) - len(tail) + start]
    above = [l.strip() for l in head[-14:] if not RULE.match(l)]
    return "\n".join(above[-8:])[-600:], opts[:6]


def keys_for(key):
    """The bytes that pick an option: its digit, or arrows from the cursor then Enter."""
    if not key.startswith("m"):
        return key
    want, cur = (int(x) for x in key[1:].split(":"))
    return ("\x1b[B" * (want - cur) if want >= cur else "\x1b[A" * (cur - want)) + "\r"


def fingerprint(lines, opts):
    """A prompt's identity: hashes of its text as drawn and with no spacing at all, so a
    reflow can be told from a new prompt. The text runs from the rule Claude draws above
    a prompt, which holds the whole command where the shown context is a short window two
    commands can share, to the last option. The chat above and footer below can tick."""
    if not opts:
        return "", ""
    end = max((n for n, l in enumerate(lines) if opts[-1][1] in l), default=len(lines) - 1)
    first = next((n for n in range(end, -1, -1) if opts[0][1] in lines[n]), end)
    top = next((n + 1 for n in range(first - 1, -1, -1) if SOLID.match(lines[n])), max(0, first - 14))
    text = "\n".join(l.rstrip() for l in lines[top:end + 1])
    return (hashlib.sha256(text.encode()).hexdigest(),
            hashlib.sha256("".join(text.split()).encode()).hexdigest())


# For a prompt Invoke can't read, which might be a command to approve, only the key that can't approve.
BLIND = {"Press Esc": "\x1b"}


def screen_tail(lines):
    return "\n".join(l.strip() for l in lines if l.strip() and not RULE.match(l))[-500:]


def forget_needs(slug):
    if _needs.pop(slug, None):
        write_atomic(NEEDS, json.dumps(_needs))


def needs_you(p):
    """A pane stopped for the user (a permission prompt or a question: Seance's purple
    needs-human): say so in its circle's thread, with the prompt's options as buttons that
    answer the pane itself. One ping per stuck prompt: its note can
    change, it can read blank for a while, or it can reflow. Any
    read that differs still gets a new message, because only the newest message's
    buttons press anything."""
    slug, now = p["slug"], time.time()
    last = _needs.get(slug)
    if not stopped(p):
        _blank.pop(slug, None)
        if last and (p.get("activity") == "busy" or now - last["seen"] > NEEDS_HOLD):
            forget_needs(slug)
        return
    note = ((p.get("status_note") if p.get("status") == "needs-human" else "")
            or "it's waiting on you").strip()
    lines = screen_lines(slug)
    context, opts = prompt_in(lines)
    opts = [list(o) for o in opts]
    mark, flat = fingerprint(lines, opts)
    if last and not opts:
        # A blank stays silent, unless the last post has a spent button or none, and can do better.
        posted = store.msgs.get(last["mid"]) or {}
        again = not last["opts"] and (posted.get("picked") or (lines and not posted.get("choices")))
        if again:
            last.setdefault("tapped", now)
        if not (again and now - last["tapped"] >= NEEDS_BLANK) \
                and (not last["opts"] or now - last["seen"] < NEEDS_HOLD):
            return
    tapped = False
    if last and opts and mark == last["mark"]:
        # A tapped prompt still up after a moment is back (or the tap failed): its button is spent.
        if not (store.msgs.get(last["mid"]) or {}).get("picked"):
            last["seen"] = now
            return
        last.setdefault("tapped", now)
        if now - last["tapped"] < NEEDS_BLANK:
            return
        tapped = True
    if not opts and now - _blank.setdefault(slug, now) < NEEDS_BLANK:
        return
    _blank.pop(slug, None)
    name = (p.get("name") or slug).split(" \u00b7 ")[0]
    text = f"{name} needs you: {note}."
    if context:
        text += f"\n\n{context}"
    tail = screen_tail(lines) if not opts else ""
    if tail:
        text += f"\n\nI can't read this prompt, so here's the bottom of its screen:\n\n{tail}"
    elif not opts:
        text += "\n\nIts screen can't be read right now."
    m = store.add(p["workspace"], "lead", text,
                  choices=[label for _, label in opts] or (list(BLIND) if tail else []))
    if tail:
        save_ask(m["id"], {"pane": slug, "tail": tail})
    if opts:
        save_ask(m["id"], {"pane": slug, "mark": mark, "opts": opts})
    quiet = last and flat and not tapped and flat == last["flat"]  # same words, reflowed: new buttons, no ping
    _needs[slug] = {"opts": opts, "mark": mark, "flat": flat, "mid": m["id"], "seen": now}
    write_atomic(NEEDS, json.dumps(_needs))
    if not quiet:
        threading.Thread(target=push, args=(p["workspace"], name, f"needs you: {note}"), daemon=True).start()


def answer_pane(mid, msg, ask, choice):
    """The user tapped an option on a needs-you message: press its digit in the pane,
    only if this is the pane's newest prompt message and the screen still shows
    exactly that prompt, so an old tap can't approve a newer command."""
    try:
        with pane_lock(ask["pane"]):  # read then press as one step, against a double tap
            newest = max((int(k) for k, a in read_json(ASKS, {}).items()
                          if a.get("pane") == ask["pane"]), default=mid)
            row = pane_row(ask["pane"]) or {}
            lines = screen_lines(ask["pane"])
            _, opts = prompt_in(lines)
            key = next((k for k, label in opts if label == choice), None)
            same = [list(o) for o in opts] == [list(o) for o in ask.get("opts", [])] \
                and fingerprint(lines, opts)[0] == ask.get("mark")
            if "tail" in ask:  # never mid-turn, where Esc would stop the running tool
                key, same = BLIND.get(choice), not opts and row.get("activity") != "busy"
            if mid != newest or not stopped(row) or not same or not key:
                store.set_status(msg["id"], "failed")
                reply(msg["ws"], "That prompt isn't up anymore, so nothing was pressed.", "system")
                return
            out = ctl("send-raw", ask["pane"], keys_for(key))
    except Exception as e:
        print(f"answer_pane {ask['pane']}: {e}", file=sys.stderr, flush=True)
        store.set_status(msg["id"], "failed")
        reply(msg["ws"], f"Couldn't press it: {e}", "system")
        return
    store.set_status(msg["id"], "answered" if out.returncode == 0 else "failed")
    if out.returncode != 0:
        reply(msg["ws"], f"Couldn't press it: {(out.stderr or out.stdout).strip()[-200:]}", "system")


FREE_TEXT = re.compile(r"^(type something|chat about this)", re.I)


RUN_WAIT = 1800  # how long a command waits for a busy lead before giving up
RAN = ("The user ran this in your pane from Chat: `{shown}`. Its output is on your screen. "
       "Tell them in a line or two whether it worked, then carry on with what it unblocks.")
SLASH = re.compile(r"/[a-z][a-z0-9:_-]*(?: .*)?$")  # a Claude command, not a path like /tmp/x


def type_command(pane, command):
    """Into the prompt box: `!` and a shell command (Claude's shell mode), or a `/command`;
    then Enter. The box may show a ghost suggestion, so emptiness can't be read first: the
    first key must leave the box holding only itself, or it's taken back and nothing lands
    in a draft or a menu. Shell mode is never left on, where the next task would run as a
    command. Returns why it didn't run, or None."""
    key, rest = ("/", command[1:]) if SLASH.match(command) else ("!", command)
    out = ctl("send-raw", pane, key)
    if out.returncode != 0:
        return (out.stderr or out.stdout).strip()[-200:]
    typed = done = False
    try:
        time.sleep(0.6)  # let the mode or the command menu come up
        box = re.compile(rf"\s*(?:\u276f\s*)?{key}\s*")
        if not any(box.fullmatch(l) for l in screen_lines(pane)[-30:]):
            return "its prompt box wasn't empty"
        typed = True
        for step, wait in ((rest, 0.3), ("\r", 0)):
            out = ctl("send-raw", pane, step)
            if out.returncode != 0:
                return (out.stderr or out.stdout).strip()[-200:]
            time.sleep(wait)
        done = True
    finally:
        if typed and not done:
            ctl("send-raw", pane, "\x15")  # clear the line, which is the command
        if not done:
            ctl("send-raw", pane, "\x7f")  # and the `!`, leaving any draft as it was
    return None


def free(row, pane):
    """The pane can take a command: at rest, nothing queued to land in shell mode, and if
    it still says it's stopped (Esc leaves that behind), no prompt on screen."""
    return (row.get("activity") in ("idle", "awaiting-input") and not row.get("queued_tasks")
            and (not stopped(row) or not prompt_in(screen_lines(pane))[1]))


def run_in_pane(msg, pane, command):
    """Run the user's command in the lead's pane when it's free, then give the lead a task
    to report back, so the answer lands in the thread like any other. The command runs
    exactly as written and shown, so anything a single typed line can't hold is refused."""
    def refuse(why):
        store.set_status(msg["id"], "failed")
        if msg.get("offer"):
            store.unpick(msg["offer"])
        reply(msg["ws"], f"That didn't run: {why}.", "system")

    if not command.isprintable() or command.endswith("\\"):
        refuse("it has to be one plain line")
        return
    shown = command if SLASH.match(command) else f"! {command}"
    until, woke, told = time.time() + RUN_WAIT, False, False
    while True:
        row = pane_row(pane) or {}
        if row.get("asleep"):
            if not woke:
                ctl("wake", row["workspace"])
                woke = True
        elif row and free(row, pane):
            with pane_lock(pane):
                row = pane_row(pane) or {}
                msg["typed"] = True  # a failure from here on may have run it: no retap
                err = type_command(pane, command) if row and free(row, pane) else ""
            if err is None:
                break
            msg["typed"] = False
            if err:
                refuse(err)
                return
        if time.time() > until:
            refuse(f"{pane} wasn't free for 30 minutes")
            return
        if not told:
            store.add(msg["ws"], "system", f"{pane} is busy, so {shown} will run when it's free "
                                           "(30 minutes at most).")
            told = True
        time.sleep(4)
    store.set_status(msg["id"], "got")
    store.add(msg["ws"], "system", f"Ran in {pane}: {shown}")  # whatever happens to the report
    time.sleep(5)  # let the pane show busy, so the report queues behind the command
    queue_task(dict(msg, text=RAN.format(shown=shown)), pane)


def typed_answer(msg, pane):
    """The user typed into a thread whose lead is stopped on a Claude question: pick its
    free-text option ("Type something.", else "Chat about this"), type their text and
    press Enter, with answer_pane's checks (the pane's newest prompt message, still
    on screen). False when there's no such prompt, so the caller delivers as usual."""
    # One printable line: a newline would submit early, an escape byte could steer the pane.
    text = "".join(c for c in " ".join(msg["text"].split()) if c.isprintable()).strip()
    if msg.get("image") or msg.get("attachment") or not text:  # a photo or file can't go into a text box
        return False
    with pane_lock(pane):
        asks = {int(k): a for k, a in read_json(ASKS, {}).items() if a.get("pane") == pane}
        if not asks:
            return False
        ask = asks[max(asks)]
        lines = screen_lines(pane)
        _, opts = prompt_in(lines)
        same = [list(o) for o in opts] == [list(o) for o in ask.get("opts", [])] \
            and fingerprint(lines, opts)[0] == ask.get("mark")
        # Digits only: an arrow-menu key ends in Enter and would submit before the text.
        free = sorted((k for k, label in opts if FREE_TEXT.match(label) and k.isdigit()),
                      key=lambda k: not dict(opts)[k].lower().startswith("type"))
        if not same or not free or not stopped(pane_row(pane) or {}):
            return False
        err = None
        try:
            for step, wait in ((free[0], 0.6), (text, 0.3), ("\r", 0)):  # 0.6: let the text box open
                out = ctl("send-raw", pane, step)
                if out.returncode != 0:
                    err = (out.stderr or out.stdout).strip()[-200:]
                    break
                time.sleep(wait)
        except Exception as e:
            err = str(e)
    store.set_status(msg["id"], "failed" if err else "answered")
    if err:
        reply(msg["ws"], f"Couldn't type that into {pane}'s question; check its screen: {err}", "system")
    return True


def new_texts(pane, pad, start):
    """Phone-marked notes (not finishes) after `start` not already shown."""
    out = []
    stamps = list(STAMP.finditer(pad, start))
    with _used_lock:
        used = _used.setdefault(pane, set())
        for i, m in enumerate(stamps):
            end = stamps[i + 1].start() if i + 1 < len(stamps) else len(pad)
            body = pad[m.end():end].strip()
            if (body.startswith("\U0001F4F1") and not FINISH.match(pad, m.start())
                    and seen_key(m) not in used):
                used.add(seen_key(m))
                out.append(body[1:].strip() or "(empty text)")
        if out:
            save_used()
    return out


_leads = {}


def lead_of_cached(ws):
    """The circle's lead slug, looked up at most once a minute."""
    hit = _leads.get(ws)
    if not hit or time.time() - hit[1] > 60:
        out = ctl("lead", ws, "--json")
        try:
            hit = (json.loads(out.stdout)["data"]["lead"], time.time())
        except (ValueError, KeyError, TypeError):
            hit = (None, time.time())
        _leads[ws] = hit
    return hit[0]


def circle_working(ws, ps=None):
    """Whether any pane in the circle is mid-turn."""
    return any(p["workspace"] == ws and p.get("activity") == "busy" for p in ps or panes())


SUBAGENT_MAX = 1800  # a stop can go missing (the session died): a subagent older than this is gone
subagent_runs = {}  # ws -> {agent id: start time}, fed by crew-subagent.py


def subagent_event(ws, agent, on):
    running = subagent_runs.setdefault(ws, {})
    if on:
        running[agent] = time.time()
    else:
        running.pop(agent, None)
    with store.lock:
        store._bump()  # both apps redraw now, not at their next poll


def crew(ws, ps):
    """Who dances in the circle's crew: busy panes by their place in the circle,
    then running subagents numbered after every pane, so each keeps its shade."""
    rows = [p for p in ps if p["workspace"] == ws]
    now = time.time()
    running = {a: t for a, t in subagent_runs.get(ws, {}).items() if now - t < SUBAGENT_MAX}
    subagent_runs[ws] = running
    return ([i for i, p in enumerate(rows) if p.get("activity") == "busy"]
            + [len(rows) + i for i in range(len(running))])


_tasks = {}  # finished task id -> row; a finished task never changes
NAMES = os.path.join(STATE, "task-names.json")  # task id -> the name its lead gave it
NAME_MARK = "\U0001F4CB"


def task_names():
    return read_json(NAMES, {})


def name_current_task(p, names):
    """The name the lead gave its open task: the last pad note opening with
    the clipboard mark since the task arrived. Saved, so it outlives the task."""
    tid = p.get("task_id")
    if p.get("task_status") != "open" or not tid:
        return
    pad = pad_text(p["slug"]).encode()[p.get("inject_pad_bytes") or 0:].decode(errors="ignore")
    found = None
    for m in STAMP.finditer(pad):
        body = pad[m.end():].split("\n---", 1)[0].strip()
        if body.startswith(NAME_MARK) and body[len(NAME_MARK):].strip():
            found = body[len(NAME_MARK):].strip().splitlines()[0][:80]
    if found and names.get(tid) != found:
        names[tid] = found
        write_atomic(NAMES, json.dumps(names))


def task_row(pane, tid):
    if tid in _tasks:
        return _tasks[tid]
    out = ctl("task", "--id", tid, "--json", pane)
    try:
        t = json.loads(out.stdout)["data"]
    except (ValueError, KeyError, TypeError):
        _tasks[tid] = None  # pruned from Seance's state: don't ask again
        return None
    body = t.get("body") or ""
    # Phone tasks carry a header and the reply how-to; keep only what the user typed.
    phone = body.startswith("\U0001F4F1 From the user")
    if phone:
        body = body.split("\n", 1)[-1]
    body = body.split("\n---\n")[0].strip()
    row = {"id": tid, "status": t.get("status"), "text": body[:2500], "phone": phone,
           "start": t.get("created_ms"), "end": t.get("finished_ms")}
    if row["status"] not in ("open", "queued", "parked"):
        _tasks[tid] = row
    return row


def recent_task_ids(pane, n=8):
    """The pane's last n task ids, newest first, from the tail of Seance's event log."""
    try:
        with open(EVENTS, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 4_000_000))
            lines = f.read().decode(errors="replace").splitlines()
    except OSError:
        return []
    ids = []
    for line in reversed(lines):
        if '"task_open"' not in line or f'"pane":"{pane}"' not in line:
            continue
        try:
            tid = json.loads(line)["detail"]
        except (ValueError, KeyError):
            continue
        if tid not in ids:
            ids.append(tid)
            if len(ids) == n:
                break
    return ids


SPINNER = re.compile(r"^\S\s+\S+…\s+\(\d.*$", re.M)
# Claude's background-agent rows under the prompt: "◯ ship-reviewer  Tracing …   4m 6s · ↓ 126k tokens".
AGENT_ROW = re.compile(r"^[ \t]*[◯◉◎○●][ \t]+(\S+)[ \t]{2,}(.+?)[ \t]{2,}(\d[^·\n]*?)[ \t]*(?:·.*)?$", re.M)


def doing(p):
    """Claude's spinner line ("Blanching… (5m · ↓ 7k tokens)"). Seance's activity
    evidence is sometimes the window title instead, so then read it off the screen."""
    if p.get("activity") != "busy":
        return None
    ev = p.get("activity_evidence") or ""
    if SPINNER.fullmatch(ev):
        return ev
    hits = SPINNER.findall(screen(p["slug"]))
    return hits[-1].strip() if hits else None


def screen(slug):
    return ctl("read", slug, "--all", "--lines", "30", timeout=10).stdout


def subagents(p):
    """The lead's background agents (reviews, searches) from Claude's agent rows."""
    if p.get("activity") != "busy":
        return []
    return [{"name": n, "doing": d.strip(), "for": t.strip()}
            for n, d, t in AGENT_ROW.findall(screen(p["slug"])) if n != "main"]


def lead_tasks(ws):
    """The lead's to-do list for the phone: what it's on now and how far along,
    what waits behind it, its busy helpers, and what it finished lately."""
    lead = lead_of_cached(ws)
    ps = panes()
    p = next((x for x in ps if x["slug"] == lead), None)
    if not p:
        return {"lead": None}
    now = p.get("task_id") if p.get("task_status") == "open" else None
    names = task_names()
    name_current_task(p, names)
    queued, parked = list(p.get("queued_tasks") or []), list(p.get("parked_tasks") or [])
    rows = lambda ids: [dict(r, name=names.get(r["id"])) for r in (task_row(lead, t) for t in ids) if r]
    done = [t for t in recent_task_ids(lead, 16) if t != now and t not in queued + parked]
    def helper(x):
        t = task_row(x["slug"], x["task_id"]) if x.get("task_id") and x.get("task_status") == "open" else None
        return {"name": x.get("name") or x["slug"], "doing": doing(x),
                "task": (names.get(t["id"]) or t["text"].split("\n")[0][:200]) if t else None}
    helpers = [helper(x) for x in ps
               if x["workspace"] == ws and x["slug"] != lead and x.get("activity") == "busy"]
    return {"lead": p.get("name") or lead, "busy": p.get("activity") == "busy",
            "doing": doing(p), "now": rows([now] if now else []),
            "waiting": rows(queued), "parked": rows(parked), "helpers": helpers,
            "agents": subagents(p),
            "done": [r for r in rows(done) if r["status"] in ("done", "orphaned")][:6]}


def dismiss_parked(ws, tid):
    """Close one of the lead's parked tasks without a word to the lead (the user
    swipes it away): finish it by id, no pad text, so the lead's turn is untouched."""
    lead = lead_of_cached(ws)
    p = next((x for x in panes() if x["slug"] == lead), None)
    if not p or tid not in (p.get("parked_tasks") or []):
        return False
    out = ctl("finish", "--pane", lead, "--task", tid, "--status", "done", "--empty-ok",
              "--note", "dismissed from the user's to-do list")
    _tasks.pop(tid, None)
    return out.returncode == 0


def resume_parked(ws, tid, device="phone"):
    """The user taps Work on this: the parked task goes back to the lead as a new
    message from them in the thread (so its answer comes back like any other),
    and the parked copy is closed."""
    lead = lead_of_cached(ws)
    row = task_row(lead, tid) if lead else None
    if not row or not dismiss_parked(ws, tid):
        return None
    name = task_names().get(tid)
    text = (f"Pick this back up (it was parked): {name}\n\n" if name else
            "Pick this back up (it was parked):\n\n") + row["text"]
    msg = store.add(ws, "me", text, "sending", device=device)
    store.mark_read(ws, msg["id"])
    threading.Thread(target=deliver, args=(msg,), daemon=True).start()
    return msg


def open_tasks(ws, ps):
    """How many tasks the lead has open or queued, for the to-do icon's badge.
    Parked ones are left out: Seance rarely clears them, so they'd pin the count."""
    lead = lead_of_cached(ws)
    p = next((x for x in ps if x["slug"] == lead), None)
    if not p:
        return 0
    return (p.get("task_status") == "open") + len(p.get("queued_tasks") or [])


def resume_pending():
    """Waits that a restart cut off pick up where they were."""
    for mid, rec in list(store.pending.items()):
        threading.Thread(target=_resume, args=(int(mid), rec), daemon=True).start()


def _resume(mid, rec):
    try:
        if rec.get("kind") == "note":
            await_note(mid, rec)
        else:
            threading.Thread(target=watch_ack, args=(mid, rec), daemon=True).start()
            await_answer(mid, rec)
    except Exception as e:
        print(f"resume {mid}: {e}", file=sys.stderr, flush=True)


